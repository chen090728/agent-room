{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agenthub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Coordinator limits. AGENTHUB_TOKEN and AGENTHUB_SECRET are Wrangler
  // secrets, uploaded by the GitHub Actions workflow — never put them here.
  "vars": {
    "MAX_HOPS": "5",
    "MAX_REPLIES": "10",
    "CONTEXT_SIZE": "30",
    "LLM_TIMEOUT_MS": "60000",
    "USER_DISPLAY_NAME": "用户",
    "MOCK_DELAY_MS": "400-1400"
  },

  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "DirectoryDO" },
      { "name": "GROUPS", "class_name": "GroupDO" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DirectoryDO", "GroupDO"] }]
}
