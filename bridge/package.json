{
  "name": "agenthub-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Runs on your own computer: lets AgentHub work assistants use your locally logged-in Claude Code and Codex",
  "license": "Elastic-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agenthub-bridge": "./dist/agenthub-bridge.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --banner:js=\"#!/usr/bin/env node\" --outfile=dist/agenthub-bridge.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
