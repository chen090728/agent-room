# AgentHub server config. Copy to .env (or run `npm run init-env`, which fills
# in random secrets for you). Never commit the real .env.

# Address and port the server listens on.
HOST=0.0.0.0
PORT=8787

# Access token the App must present. Anyone with this token can use your
# members (and therefore your API keys), so make it long and random.
# Generate one with: openssl rand -hex 24
AGENTHUB_TOKEN=

# Secret used to encrypt member API keys stored in SQLite (AES-256-GCM).
# If you lose or change it, stored keys can no longer be decrypted and must be
# re-entered. Generate one with: openssl rand -hex 32
AGENTHUB_SECRET=

# SQLite database file (relative to the server directory).
DB_PATH=./data/agenthub.db

# Coordinator limits per original message.
MAX_HOPS=5
MAX_REPLIES=10

# How many recent messages are sent to a member as context.
CONTEXT_SIZE=30

# Timeout for one model request, in milliseconds.
LLM_TIMEOUT_MS=60000

# How the human is named in the context sent to members.
USER_DISPLAY_NAME=用户

# Random wait before mock members answer, in milliseconds (min-max).
MOCK_DELAY_MS=400-1400
